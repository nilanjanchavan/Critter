[Unit]
Description=Critter Desktop Pet Automation Service
Documentation=https://github.com/nilanjanchavan/Critter
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/critter --pets dog,cat
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target

